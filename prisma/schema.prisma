generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Field {
  id             String   @id @default(cuid())
  slug           String   @unique
  displayName    String
  username       String   @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  /// Legacy field — booking length now comes from each schedule window.
  slotMinutes    Int      @default(60)
  /// How long a public hold waits for SMS confirmation
  holdMinutes    Int      @default(15)
  /// Platform admin: allows this field to send customer SMS
  smsPlanEnabled Boolean  @default(true)
  /// Monthly limit for SMS messages this field can send (0 = unlimited).
  smsMonthlyLimit Int     @default(0)
  /// Owner mobile (optional, for later alerts)
  phone          String?
  /// Public logo URL path (API). When set, replaces the name in the hero.
  logoUrl        String?
  /// Binary logo payload stored in DB (survives Render deploys)
  logoData       Bytes?
  logoMimeType   String?
  /// Optional text under the logo on the public booking page
  introText      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workingHours WorkingHours[]
  dayOffs      DayOff[]
  smsUsage     SmsMonthlyUsage[]
  extraHours   ExtraHours[]
  bookings     Booking[]
  competitions Competition[]
}

model WorkingHours {
  id        String @id @default(cuid())
  fieldId   String
  /// 0 = Sunday … 6 = Saturday (Israel week)
  dayOfWeek Int
  startTime String
  endTime   String

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, dayOfWeek])
  @@index([fieldId])
}

model DayOff {
  id      String   @id @default(cuid())
  fieldId String
  date    DateTime @db.Date
  note    String?

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, date])
  @@index([fieldId])
}

model ExtraHours {
  id        String   @id @default(cuid())
  fieldId   String
  date      DateTime @db.Date
  startTime String
  endTime   String
  note      String?

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, date])
  @@index([fieldId])
}

model SmsMonthlyUsage {
  id        String   @id @default(cuid())
  fieldId   String
  monthKey  String
  usedCount Int      @default(0)

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, monthKey])
  @@index([fieldId, monthKey])
}

model Booking {
  id            String    @id @default(cuid())
  fieldId       String
  startsAt      DateTime
  endsAt        DateTime
  customerName  String
  customerPhone String
  /// HOLD | CONFIRMED | EXPIRED | CANCELLED
  status        String    @default("HOLD")
  /// PUBLIC | ADMIN
  source        String    @default("PUBLIC")
  confirmToken  String    @unique
  holdExpiresAt DateTime?
  confirmedAt   DateTime?
  /// When the 2-hour-before reminder SMS was sent (null = not yet)
  reminderSentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, startsAt])
  @@index([fieldId, status])
  @@index([status, holdExpiresAt])
  @@index([status, reminderSentAt, startsAt])
}

model Competition {
  id            String    @id @default(cuid())
  fieldId       String
  title         String
  goalPoints    Int
  prizeText     String
  endsAt        DateTime
  /// DRAFT | ACTIVE | PAUSED | ENDED
  status        String    @default("DRAFT")
  /// FIRST = first to goal wins and ends; ALL_WHO_REACH = everyone who hits goal before endsAt
  winMode       String    @default("FIRST")
  winnerPhone   String?
  winnerName    String?
  wonAt         DateTime?
  prizeRedeemed Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  field  Field              @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  entries CompetitionEntry[]
  events  CompetitionEvent[]

  @@index([fieldId, status])
  @@index([fieldId, endsAt])
}

model CompetitionEntry {
  id            String @id @default(cuid())
  competitionId String
  /// Normalized phone identity (E.164 preferred)
  phoneKey      String
  /// Display name from first booking in this competition
  displayName   String
  points        Int    @default(0)

  competition Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  events      CompetitionEvent[]

  @@unique([competitionId, phoneKey])
  @@index([competitionId, points])
}

model CompetitionEvent {
  id            String   @id @default(cuid())
  competitionId String
  entryId       String?
  bookingId     String?  @unique
  phoneKey      String
  delta         Int
  /// CONFIRM | CANCEL | MANUAL
  reason        String
  createdAt     DateTime @default(now())

  competition Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  entry       CompetitionEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([competitionId, createdAt])
}
